# Aiven (or any Postgres) connection string — used by drizzle-kit migrations and the seed script
DATABASE_URL="postgres://user:password@host:port/defaultdb?sslmode=require"
# Same database, used by `npm run dev` for the Hyperdrive binding when running locally
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgres://user:password@host:port/defaultdb?sslmode=require"
